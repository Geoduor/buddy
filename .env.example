# Copy to .env (repo root) and fill in real values. NEVER commit .env.
# Names only here. See README "Environment variables" for who uses each one.

# Public by design (Row Level Security protects the data)
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser code (Vite). Put these in frontend/.env.local and in Vercel. Same values as above.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret. Content importer, run on your own computer only. Never on Vercel, never in browser code.
SUPABASE_SECRET_KEY=your-secret-key

# Study Buddy (set these in Vercel only)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
# Optional model overrides
GROQ_MODEL=
GEMINI_MODEL=
